# -------------------------------------------------------------
# 🌲 Robinhood Companion Platform — Environment Config
# -------------------------------------------------------------

# 1. Supabase Database Configuration (Optional for Local, Required for Prod DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# 2. Robinhood Chain EVM Network
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=10001
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.robinhood-chain.xyz
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 3. 𝕏 (Twitter) Bot & AI Keys (Optional for live bot)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
OPENAI_API_KEY=your-openai-api-key
