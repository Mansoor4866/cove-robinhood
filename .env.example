# -------------------------------------------------------------
# 🌲 Cove Companions Platform — Environment Config
# -------------------------------------------------------------

# 1. Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# 2. Solana Network Configuration
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_COVE_PROGRAM_ID=CoveComp11111111111111111111111111111111111
NEXT_PUBLIC_COVE_TOKEN_MINT=CoveTokn11111111111111111111111111111111111

# 3. 𝕏 (Twitter) Bot & AI Keys (Optional)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
OPENAI_API_KEY=your-openai-api-key
